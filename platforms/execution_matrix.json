    {
      "platforms": ["l40s"],
      "name": "L40S GPT-2 strong-scaling exact shapes exceed available memory",
      "experiment_ids": ["E032", "E033"],
      "comparability": "platform_specific",
      "reason": "The exact GPT-2 strong-scaling shapes exceed the observed 44.52 GiB L40S capacity: E032 exhausted the one-GPU allocation after 43.32 GiB was allocated, and E033 exhausted the two-GPU allocation with 42.03 GiB allocated on rank 0 before a further 6.14 GiB request failed. Define and validate separate capacity-adjusted L40S conditions before changing batch size or accumulation; do not pool them with the exact E032/E033 conditions."
    },
    {
      "platforms": ["h100"],
      "name": "H100 GPT-2 one-GPU strong-scaling exact shape exceeds available memory",
      "experiment_ids": ["E032"],
      "comparability": "platform_specific",
      "reason": "All three exact H100 E032 trials OOMed at the preserved GPT-2 Small BF16, sequence-length 1024, global/per-GPU batch-64 shape. PyTorch had 70.34 GiB allocated with 7.65 GiB free on the observed 79.19 GiB H100 when a further 12.27 GiB request failed; only 544 MiB was reserved but unallocated. This is a capacity limit rather than remediable allocator fragmentation. Preserve E032 unchanged; register any reduced-batch investigation as an H100-only capacity-adjusted probe and do not pool it with the exact strong-scaling series."
    },
    {
      "platforms": ["h100"],
      "name": "H100 GPT-2 micro-batch 64 exact shape exceeds available memory",
      "experiment_ids": ["E068"],
      "comparability": "platform_specific",
      "reason": "All three exact H100 E068 trials OOMed at GPT-2 Small BF16, sequence length 1024, and micro-batch 64. PyTorch had 70.34 GiB allocated with 7.65 GiB free on the observed 79.19 GiB H100 when a further 12.27 GiB allocation failed; only 544 MiB was reserved but unallocated. Preserve E068 and its failed bundle unchanged. Any lower micro-batch investigation must use a new H100-only capacity-adjusted condition and must not be pooled with exact E068."
    },
    {
      "platforms": ["l40s"],
      "name": "L40S TinyLlama exact one-GPU strong-scaling shape exceeds available memory",
      "experiment_ids": ["E044"],
      "comparability": "platform_specific",
      "reason": "E044 OOMed identically in all three exact L40S trials at batch 16 and sequence length 1024: 43.30 GiB was allocated by PyTorch, 592.25 MiB was free, and a further 1000 MiB allocation failed. Preserve E044 unchanged for exact H100 execution; use the matched checkpointed E208/E209 capacity-adjusted pair for L40S strong-scaling evidence."
    },
    {
      "platforms": ["l40s"],
      "name": "L40S GPT-2 micro-batch exact shapes exceed available memory",
      "experiment_ids": ["E067", "E068"],
      "comparability": "platform_specific",
      "reason": "The exact GPT-2 micro-batch 32/64 rows exceed the observed 44.52 GiB L40S capacity. Isolated L40S retries still OOMed: E067 allocated 41.55 GiB before a further 6.14 GiB request failed, and E068 allocated 43.31 GiB before a further 768 MiB request failed. Keep E067/E068 for H100 exact evidence and run E201-E202/E205 as capacity-adjusted L40S boundary probes instead."
    },
    {
      "platforms": ["l40s"],
      "name": "L40S capacity-adjusted GPT-2 upper-bound probes exceed available memory",
      "experiment_ids": ["E203-E204", "E206-E207"],
      "comparability": "capacity_adjusted",
      "reason": "The capacity-adjusted GPT-2 micro-batch 26/27/28/30 probes exceeded the observed 44.52 GiB L40S capacity in all three trials. E206 failed before a further 4.99 GiB allocation after 34.87 GiB was allocated by PyTorch, E207 failed before a further 5.18 GiB allocation after 36.13 GiB was allocated, E203 failed before a further 5.37 GiB allocation after 37.40 GiB was allocated, and E204 failed before a further 5.75 GiB allocation after 39.04 GiB was allocated. Keep E201/E202/E205 as successful lower-bound probes; E205 at micro-batch 25 is the largest passing integer boundary observed on the 44.52 GiB L40S."
