{
  "experiment_id": "E189",
  "experiment": "inference_concurrency_tinyllama_8_requests",
  "mode": "inference",
  "workload": {
    "name": "tinyllama",
    "model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
    "dataset": "prompt_set_v1",
    "parameters": {
      "inference_study_type": "concurrency",
      "framework": "vllm",
      "batch_size": 1,
      "concurrent_requests": 8,
      "prompt_length": 128,
      "max_new_tokens": 128
    }
  },
  "hardware": {
    "platform": "lovelace_h100",
    "gpus": 1,
    "gpu_model": "NVIDIA H100 SXM 80GB",
    "interconnect": "NVLink"
  },
  "distributed": {
    "strategy": "none",
    "nodes": 1,
    "gpus_per_node": 1,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
    "enabled": true,
    "profilers": [
      "nvidia_smi",
      "serving_latency"
    ],
    "parameters": {
      "collect_latency_distribution": true,
      "collect_queueing_time": true,
      "collect_memory_trace": true,
      "collect_request_throughput": true
    }
  },
  "metadata": {
    "matrix_id": "E189",
    "template": "inference_serving",
    "phase": "Inference concurrency",
    "priority": "Must Have",
    "gpu_hours_estimate": 0.5,
    "matrix_stack_strategy": "vLLM",
    "objective": "Concurrent requests 8",
    "key_metrics": [
      "throughput",
      "p50",
      "p95",
      "queueing",
      "memory"
    ]
  }
}
