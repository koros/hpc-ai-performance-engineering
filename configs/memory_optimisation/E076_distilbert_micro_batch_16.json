{
  "experiment_id": "E076",
  "experiment": "memory_optimisation_distilbert_micro_batch_16",
  "mode": "training",
  "workload": {
    "name": "distilbert",
    "model": "distilbert-base-uncased",
    "dataset": "glue_sst2_or_synthetic_subset",
    "parameters": {
      "memory_study_type": "micro_batch",
      "batch_size": 16,
      "micro_batch_size": 16,
      "sequence_length": 512,
      "activation_checkpointing": false,
      "gradient_accumulation_steps": 1,
      "effective_batch_size": 16
    }
  },
  "hardware": {
    "platform": "lovelace_h100",
    "gpus": 1,
    "gpu_model": "NVIDIA H100 SXM 80GB",
    "interconnect": "NVLink"
  },
  "distributed": {
    "strategy": "ddp",
    "nodes": 1,
    "gpus_per_node": 1,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
    "enabled": true,
    "profilers": [
      "nvidia_smi",
      "torch_memory"
    ],
    "parameters": {
      "collect_memory_trace": true,
      "collect_oom_risk": true,
      "collect_effective_batch_metrics": false
    }
  },
  "metadata": {
    "matrix_id": "E076",
    "template": "memory_optimisation",
    "phase": "Memory optimisation",
    "priority": "Must Have",
    "gpu_hours_estimate": 0.6,
    "objective": "Sweep micro-batch size 16",
    "key_metrics": [
      "throughput",
      "memory",
      "oom",
      "loss_stability"
    ]
  }
}
