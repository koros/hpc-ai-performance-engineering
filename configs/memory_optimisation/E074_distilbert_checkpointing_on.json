{
  "experiment_id": "E074",
  "experiment": "memory_optimisation_distilbert_checkpointing_on",
  "mode": "training",
  "workload": {
    "name": "distilbert",
    "model": "distilbert-base-uncased",
    "dataset": "glue_sst2_or_synthetic_subset",
    "parameters": {
      "memory_study_type": "checkpointing",
      "batch_size": 32,
      "micro_batch_size": 32,
      "sequence_length": 512,
      "activation_checkpointing": true,
      "gradient_accumulation_steps": 1,
      "effective_batch_size": 64,
      "fsdp_config": {
        "sharding_strategy": "full_shard",
        "mixed_precision": "bf16",
        "activation_checkpointing": true
      }
    }
  },
  "hardware": {
    "platform": "lovelace_h100",
    "gpus": 2,
    "gpu_model": "NVIDIA H100 SXM 80GB",
    "interconnect": "NVLink"
  },
  "distributed": {
    "strategy": "fsdp",
    "nodes": 1,
    "gpus_per_node": 2,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
    "enabled": true,
    "profilers": [
      "nvidia_smi",
      "torch_memory"
    ],
    "parameters": {
      "collect_memory_trace": true,
      "collect_oom_risk": false,
      "collect_effective_batch_metrics": false
    }
  },
  "metadata": {
    "matrix_id": "E074",
    "template": "memory_optimisation",
    "phase": "Memory optimisation",
    "priority": "Must Have",
    "gpu_hours_estimate": 1.0,
    "objective": "Compare activation checkpointing ON",
