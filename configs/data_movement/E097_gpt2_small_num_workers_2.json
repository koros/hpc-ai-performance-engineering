      "collect_gpu_idle_time": true,
      "collect_cpu_utilisation": true
    }
  },
  "metadata": {
    "matrix_id": "E097",
    "template": "data_movement",
    "phase": "Data movement",
    "priority": "Should Have",
    "gpu_hours_estimate": 0.4,
    "objective": "DataLoader num_workers=2",
    "key_metrics": [
      "batch_load_time",
