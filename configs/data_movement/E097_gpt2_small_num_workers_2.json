{
  "experiment_id": "E097",
  "experiment": "data_movement_gpt2_small_num_workers_2",
  "mode": "training",
  "workload": {
    "name": "gpt2_small",
    "model": "gpt2",
    "dataset": "openwebtext_or_synthetic_subset",
