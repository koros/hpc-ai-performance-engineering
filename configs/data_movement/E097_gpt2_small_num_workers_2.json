    "nodes": 1,
    "gpus_per_node": 1,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
