{
  "experiment_id": "template_inference_serving",
  "experiment": "inference_serving",
  "mode": "inference",
  "workload": {
    "name": "tinyllama",
    "model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
    "dataset": "prompt_set_v1",
    "parameters": {
      "framework": "vllm",
      "batch_size": 1,
      "concurrent_requests": 1,
      "prompt_length": 128,
      "max_new_tokens": 128
    }
  },
  "hardware": {
    "platform": "lovelace_h100",
    "gpus": 1,
    "gpu_model": "NVIDIA H100 SXM 80GB",
    "interconnect": "NVLink"
  },
  "distributed": {
    "strategy": "none",
    "nodes": 1,
    "gpus_per_node": 1,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
    "enabled": true,
    "profilers": ["nvidia_smi", "serving_latency"],
    "parameters": {}
  },
  "metadata": {
    "template": "inference_serving",
    "priority": "Must Have"
  }
}
