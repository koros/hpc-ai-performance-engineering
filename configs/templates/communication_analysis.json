{
  "experiment_id": "template_communication_analysis",
  "experiment": "communication_analysis",
  "mode": "training",
  "workload": {
    "name": "gpt2_small",
    "model": "gpt2",
    "dataset": "openwebtext_or_synthetic_subset",
    "parameters": {
      "batch_size": 16,
      "sequence_length": 1024
    }
  },
  "hardware": {
    "platform": "lovelace_h100",
    "gpus": 2,
    "gpu_model": "NVIDIA H100 SXM 80GB",
    "interconnect": "NVLink"
  },
  "distributed": {
    "strategy": "ddp",
    "nodes": 1,
    "gpus_per_node": 2,
    "backend": "nccl"
  },
  "runtime": {
    "precision": "bf16",
    "max_steps": 100,
    "seed": 1337,
    "output_dir": "results/raw"
  },
  "profiling": {
    "enabled": true,
    "profilers": ["nvidia_smi", "nccl", "torch_profiler"],
    "parameters": {
      "collect_allreduce_time": true
    }
  },
  "metadata": {
    "template": "communication_analysis",
    "priority": "Must Have"
  }
}
